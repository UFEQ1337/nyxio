# ─── Bot (czytane przez nyxio.config.Settings, prefiks NYXIO_) ────────────

# Token bota Discord (Developer Portal -> Bot -> Token)
NYXIO_DISCORD_TOKEN=your-bot-token-here

# Opcjonalnie: ID gildii do natychmiastowej synchronizacji slash-komend (dev).
# Puste = synchronizacja globalna (do ~1h propagacji).
NYXIO_DEV_GUILD_ID=

# Limity ochronne
NYXIO_MAX_QUEUE_SIZE=500
NYXIO_MAX_PLAYLIST_ITEMS=100
NYXIO_IDLE_TIMEOUT_SECONDS=180

# Redis (opcjonalny write-through snapshot kolejek dla /wznow).
# Pusty = wyłączony (wtedy /wznow zawsze zwraca "brak sesji").
NYXIO_REDIS_URL=redis://redis:6379/0

# Lavalink (serwer audio). Host/port wskazują serwis z docker-compose.
NYXIO_LAVALINK_HOST=lavalink
NYXIO_LAVALINK_PORT=2333
NYXIO_LAVALINK_PASSWORD=youshallnotpass

# ─── Lavalink/YouTube (czytane przez docker-compose.yml) ─────────────────

# OAuth YouTube (omija "This video requires login" na VPS). Zostaw puste
# przy 1. starcie — Lavalink wypisze w logach link+kod do autoryzacji
# (zaloguj BURNER konto Google). Potem wklej tu wypisany refreshToken.
NYXIO_YOUTUBE_REFRESH_TOKEN=

# Sekret współdzielony Lavalink <-> yt-cipher (zdalny deszyfrator sygnatur
# YouTube). Dowolny niepusty sekret; ten sam po obu stronach (compose
# podstawia go i jako API_TOKEN yt-cipher, i jako hasło remoteCipher).
# Naprawia błąd "must find sig function" przy nowym player-script YT.
NYXIO_YTCIPHER_TOKEN=zmien-na-dowolny-sekret

# poToken/visitorData. Bez świeżej pary klienci WEB/WEBEMBEDDED zwracają
# "This video requires login" / "Video player configuration error" — czyli
# dokładnie to, co widać w logach przy zablokowanym odtwarzaniu.
#
# Domyślnie NIE wypełniaj tego ręcznie: parę generuje i podmienia na żywo
# serwis `pot-refresher` (POST /youtube do Lavalinka, bez restartu).
# Wypełnij OBIE zmienne tylko jeśli wolisz tryb ręczny — wtedy refresher
# przestaje uruchamiać generator i jedynie dosyła tę parę po restartach.
# Obie wartości MUSZĄ pochodzić z JEDNEGO przebiegu generatora; niesparowana
# lub przeterminowana para daje ten sam błąd co jej brak.
NYXIO_PO_TOKEN=
NYXIO_VISITOR_DATA=

# Co ile godzin pot-refresher generuje nową parę (para wygasa po kilku-
# kilkunastu godzinach).
NYXIO_POT_REFRESH_HOURS=6

# Polecenie generatora w kontenerze pot-refresher. Zmień, jeśli w logach
# serwisu zobaczysz `generator_output_unparsed` (obraz bazowy zmienił
# ścieżkę lub entrypoint). Log zawiera ogon wyjścia, po którym widać co
# generator faktycznie wypisał.
NYXIO_POT_GENERATOR_CMD=

# ─── Wersje obrazów (przypnij na produkcji) ──────────────────────────────
# Ruchome tagi (:4, :master, :latest) sprawiają, że `docker compose pull`
# może w dowolnym momencie podmienić działającą wersję na zepsutą.
# Przykład: NYXIO_LAVALINK_IMAGE=ghcr.io/lavalink-devs/lavalink:4.0.8
NYXIO_LAVALINK_IMAGE=
NYXIO_YTCIPHER_IMAGE=
NYXIO_REDIS_IMAGE=
NYXIO_POT_BASE_IMAGE=
